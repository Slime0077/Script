local Player = game.Players.LocalPlayer

local SG = Instance.new("ScreenGui")
SG.Parent = Player.PlayerGui
SG.Name = "KineticFullCharge"
SG.IgnoreGuiInset = true
SG.ResetOnSpawn = false

local Button = Instance.new("ImageButton")
Button.Parent = SG
Button.Name = "FullChargeButton"
Button.Size = UDim2.new(0.2, 0, 0.15, 0)
Button.Position = UDim2.new(0.4, 0, 0, 0)
Button.BackgroundColor3 = Color3.new(0, 0, 1)
Button.TextColor3 = Color3.new(1, 1, 1)

Button.Activated:Connect(function()
local Bar = Player.PlayerGui.KineticUI.Kinetic.Bar
repeat
game.ReplicatedStorage.SelfKnockback:FireServer({["Force"] = -99})
until Bar.Size = UDim2.new(1, 0, 1, 0)
end)
