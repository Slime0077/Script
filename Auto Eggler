-- Функция для имитации удержания прокси-промпта
local function fireProximityPromptWithHold(prompt, holdTime)
    if not prompt or not fireproximityprompt then
        warn("Промпт не найден или нет прав на fireproximityprompt")
        return
    end
    
    -- Начинаем удержание
    fireproximityprompt(prompt, true)  -- true = начало удержания
    
    -- Ждём нужное время
    task.wait(holdTime or prompt.HoldDuration or 1)
    
    -- Завершаем удержание
    fireproximityprompt(prompt, false) -- false = отпускание
end

