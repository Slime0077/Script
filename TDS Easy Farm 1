local Player = game.Players.LocalPlayer

local Music = workspace:WaitForChild("Music")
local Lose = false
local Win = false

Music.Changed:Connect(function()
    if Music.Value == "Lose" then
        Lose = true
        Restart()
    elseif Music.Value == "Triumph" then
        Win = true
        StartNewGame()
    end
end)

local CashTextLabel = nil
local LastCashValue = -1

local function ParseCash(Text)
    if not Text then return 0 end
    local CleanText = Text:gsub("[%$,%s]", "")
    return tonumber(CleanText) or 0
end

local function GetPlayerCash()
    if not CashTextLabel then
        local PlayerGui = Player:WaitForChild("PlayerGui")
        local ReactHotbar = PlayerGui:WaitForChild("ReactUniversalHotbar", 5)
        
        if ReactHotbar then
            local Frame = ReactHotbar:WaitForChild("Frame", 5)
            if Frame then
                local Values = Frame:WaitForChild("values", 5)
                if Values then
                    local Cash = Values:WaitForChild("cash", 5)
                    if Cash then
                        CashTextLabel = Cash:WaitForChild("amount", 5)
                    end
                end
            end
        end
        
        if not CashTextLabel then return 0 end
    end

    local CurrentCash = ParseCash(CashTextLabel.Text)
    
    if CurrentCash ~= LastCashValue then
        LastCashValue = CurrentCash
    end
    
    return CurrentCash
end

local function WaitUntil(UntilArg1, UntilArg2, UntilType)
    if UntilType == "Comparison2" then
        repeat
            task.wait(0.1)
        until UntilArg1 >= UntilArg2
        return true
    end
end

function WaitUntilMoney(Required)
    local Money = GetPlayerCash()
    repeat
        Money = GetPlayerCash()
        task.wait(0.1)
    until Money >= Required or Lose == true
    return true
end

function PlaceTower(Tower, Position)
    local NewSpawnedTower = nil
    
    local TowerConnection
    TowerConnection = workspace.Towers.ChildAdded:Connect(function(NewTower)
        NewSpawnedTower = NewTower
        TowerConnection:Disconnect()
    end)
    
    local args = {
        [1] = "Troops",
        [2] = "Place",
        [3] = {
            ["Rotation"] = CFrame.new(0, 0, 0) * CFrame.Angles(0, 0, 0),
            ["Position"] = Position
        },
        [4] = Tower
    }
    game:GetService("ReplicatedStorage").RemoteFunction:InvokeServer(unpack(args))
    
    local StartTime = tick()
    while not NewSpawnedTower and (tick() - StartTime) < 3 do
        task.wait(0.05)
    end
    
    if TowerConnection.Connected then
        TowerConnection:Disconnect()
    end
    
    return NewSpawnedTower
end

