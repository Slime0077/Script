local AutoSkipEnabled = false

function AutoSkip(Enabled)

    AutoSkipEnabled = Enabled

    if Enabled == false then
        return
    end

    task.spawn(function()
        while AutoSkipEnabled do
            local args = {
                [1] = "Voting",
                [2] = "Skip"
            }

            game:GetService("ReplicatedStorage").RemoteFunction:InvokeServer(unpack(args))
            task.wait(0.1)
        end
    end)
end

local function Skip()
local args = {
        [1] = "Voting",
        [2] = "Skip"
    }

    game:GetService("ReplicatedStorage").RemoteFunction:InvokeServer(unpack(args))
end

