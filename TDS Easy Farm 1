function Restart()
    Lose = false
    task.wait(2)
    Skip()
    repeat
        task.wait(1)
    until EasyFarm1Completed == true
    Lose = false
    task.wait(2)
    EasyFarm1()
end

function StartNewGame()
    Lose = false
    task.wait(2)
    Skip()
    repeat
        task.wait(1)
    until EasyFarm1Completed == true
    Lose = false
    task.wait(2)
    local Button = Player.PlayerGui.ReactGameNewRewards.Frame.gameOver.RewardsScreen.ButtonFrame.PlayAgain.button
    if firesignal then
        firesignal(Button.Activated)
    end
end

