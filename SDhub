local function AddSection(SectionName, SectionText, LayoutOrder)
	local Player = game.Players.LocalPlayer
	local Gui = Player.PlayerGui:WaitForChild("SDhub246")
	local TemplateFolder = Gui.TemplateFolder

	local NewSection = TemplateFolder:FindFirstChild("SectionTemplate"):Clone()
	NewSection.Name = SectionName
	NewSection.Text = SectionText
	NewSection.LayoutOrder = LayoutOrder
	NewSection.Parent = Gui.MainBg.SectionList
	NewSection.Visible = true

	local NewSectionFolder = Instance.new("Folder")
	NewSectionFolder.Name = SectionName
	NewSectionFolder.Parent = Gui.MainBg.FunctionsList

	local UiListLayout = Instance.new("UIListLayout")
	UiListLayout.Parent = NewSectionFolder
	UiListLayout.SortOrder = Enum.SortOrder.LayoutOrder
	UiListLayout.Padding = UDim.new(0, 0)
	UiListLayout.FillDirection = Enum.FillDirection.Vertical
	UiListLayout.VerticalAlignment = Enum.VerticalAlignment.Top

	NewSection.Activated:Connect(function()
		task.spawn(function()
			for _, Func in pairs(Gui.MainBg.FunctionsList:GetDescendants()) do
				if Func:IsA("TextButton") or
					Func:IsA("ImageButton") or
					Func:IsA("TextBox") then

					Func.Visible = false

				end
			end

			for _, Func in pairs(Gui.MainBg.FunctionsList[SectionName]:GetChildren()) do
				if Func:IsA("TextButton") or
					Func:IsA("ImageButton") or
					Func:IsA("TextBox") then

					Func.Visible = true

				end
			end

		end)
	end)
end



local function AddFunction(SectionName, FunctionName, FunctionText, LayoutOrder, Script, Color3value, TextColor3value, Visible)
	local Player = game.Players.LocalPlayer
	local Gui = Player.PlayerGui:WaitForChild("SDhub246")
	local TemplateFolder = Gui.TemplateFolder

	local NewFunction = TemplateFolder:FindFirstChild("FunctionTemplate"):Clone()
	NewFunction.Name = FunctionName
	if TextColor3value then
		NewFunction.TextColor3 = TextColor3value
	end
	NewFunction.Text = FunctionText
	if Color3value then
		NewFunction.BackgroundColor3 = Color3value
	end
	NewFunction.LayoutOrder = LayoutOrder
	NewFunction.Parent = Gui.MainBg.FunctionsList[SectionName]
	NewFunction.Visible = Visible

	NewFunction.Activated:Connect(function()
		task.spawn(function()
			Script()
		end)
	end)
end



