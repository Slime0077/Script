AddFunction("Spider", "ESPPlayers", "ESP Players", 1, function()

local Players = game:GetService("Players")
local player = Players.LocalPlayer

local function addESP(character)
    -- Проверяем, что персонаж существует
    if not character then return end
    
    -- Проверяем, не является ли персонаж игроком
    local targetPlayer = Players:GetPlayerFromCharacter(character)
    if not targetPlayer then return end
    
    -- Пропускаем себя (сравниваем по Player, а не по Character)
    if targetPlayer == player then return end
    
    -- Проверяем, нет ли уже ESP
    if character:FindFirstChild("ESP") then return end
    
    local ESP = Instance.new("Highlight")
    ESP.Name = "ESP"
    ESP.Parent = character
    ESP.FillColor = Color3.fromRGB(0, 0, 0)
    ESP.FillTransparency = 1
    ESP.OutlineColor = Color3.fromRGB(255, 0, 0)
    ESP.OutlineTransparency = 0
end

-- Для всех игроков (кроме себя)
local function setupPlayer(p)
    if p == player then return end  -- Пропускаем себя полностью
    
    p.CharacterAdded:Connect(function(character)
        task.wait(0.5)
        addESP(character)
    end)
    if p.Character then
        task.wait(0.5)
        addESP(p.Character)
    end
end

-- Для уже зашедших
for _, p in pairs(Players:GetPlayers()) do
    setupPlayer(p)
end

-- Для новых
Players.PlayerAdded:Connect(setupPlayer)

end, Color3.new(1, 0, 0), nil, false)

