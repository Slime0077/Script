local function FindTroop(TroopName, TroopLevelValue)        -FindTroop Function

for _, v in pairs(workspace.Troops:GetChildren()) do
    if v.Name == TroopName then
        if v.TroopLevel.Value == TroopLevelValue then
            return v
        else
            continue
        end
    else
        continue
    end
end

end



local function Upgrade(Troop)        -Upgrade Function

local args = {
    [1] = {
        [1] = {
            [1] = "\226\129\130#",
            [2] = Troop
        }
    }
}

Event:FireServer(unpack(args))

end


local function PlaceTroop(Troop, TroopPosition)        -Place Function

local args = {
    [1] = {
        [1] = {
            [1] = "\226\129\130\22",
            [2] = Troop,
            [3] = Position,
            [4] = 1
        }
    }
}

Event:FireServer(unpack(args))

end




