if game.PlaceId == 103505724406848 then
    task.spawn(function()
        repeat task.wait() until workspace:FindFirstChild("BossAreaSpawn") and workspace:FindFirstChild("Enemies")
        
        local Enemies = workspace:WaitForChild("Enemies")
        local Player = game.Players.LocalPlayer
        
        repeat 
            task.wait(1)
            
            -- Заморозка персонажа (замена CreateFreezeBV)
            if Player.Character and Player.Character:FindFirstChild("HumanoidRootPart") then
                Player.Character.HumanoidRootPart.Anchored = true
            end
            
            if workspace:FindFirstChild("BossAreaSpawn") then
                Player.Character:PivotTo(workspace.BossAreaSpawn.CFrame * CFrame.new(0, 65, 0))
                Player.Character:PivotTo(Player.Character:GetPivot() * CFrame.Angles(0, math.rad(-90), 0))
            end
            
            for i, v in pairs(Enemies:GetChildren()) do
                if v:FindFirstChild("Head") and v:FindFirstChild("Humanoid") and v.Humanoid.Health > 0 then
                    game:GetService("ReplicatedStorage").Remotes.GeneralHit:FireServer(v.Head)
                end
            end
        until workspace.Enemies:FindFirstChild("Boss Zombie")
        
        wait(0.6)
        
        while true do
            if workspace.Enemies:FindFirstChild("Boss Zombie") and workspace.Enemies["Boss Zombie"]:FindFirstChild("Head") then
                local BossHead = workspace.Enemies["Boss Zombie"].Head
                game:GetService("ReplicatedStorage").Remotes.GeneralHit:FireServer(BossHead)
            end
            task.wait()
        end
    end)
end
