task.spawn(function()
while true do

    local HttpService = game:GetService("HttpService")
local TeleportService = game:GetService("TeleportService")
local Players = game:GetService("Players")
local placeId = game.PlaceId
local currentJobId = game.JobId

-- Хранилище заблокированных серверов с временем блокировки
local blockedServers = {} -- { ["jobId"] = os.time() + 600 }

-- Функция очистки устаревших записей (запускать перед каждым поиском)
local function cleanExpiredServers()
    local currentTime = os.time()
    local toRemove = {}
    
    for jobId, expireTime in pairs(blockedServers) do
        if currentTime >= expireTime then
            table.insert(toRemove, jobId)
        end
    end
    
    for _, jobId in ipairs(toRemove) do
        blockedServers[jobId] = nil
    end
    
    if #toRemove > 0 then
        print("Очищено заблокированных серверов: " .. #toRemove)
    end
end

-- Блокировка сервера на 10 минут (600 секунд)
local function blockServer(jobId)
    blockedServers[jobId] = os.time() + 600
    print("Сервер " .. jobId .. " заблокирован до " .. os.date("%H:%M:%S", blockedServers[jobId]))
end

-- Основная функция поиска нового сервера
local function findNewServer()
    cleanExpiredServers() -- Удаляем разблокированные сервера
    
    local success, response = pcall(function()
        return game:HttpGetAsync("https://games.roblox.com/v1/games/" .. placeId .. "/servers/Public?sortOrder=Asc&limit=100")
    end)
    
    if not success then
        warn("Не удалось получить список серверов")
        return
    end
    
    local data = HttpService:JSONDecode(response)
    local availableServers = {}
    
    for _, server in ipairs(data.data) do
        local serverId = server.id
        
        -- Пропускаем текущий сервер
        if serverId ~= currentJobId then
            -- Пропускаем сервера, которые ещё в "чёрном списке"
            if not blockedServers[serverId] then
                -- Проверяем, есть ли свободные места
                if server.playing and server.maxPlayers and server.maxPlayers > server.playing then
                    table.insert(availableServers, serverId)
                end
            end
        end
    end
    
    if #availableServers > 0 then
        local selectedServer = availableServers[math.random(1, #availableServers)]
        print("Выбран сервер: " .. selectedServer)
        
        -- Блокируем ТЕКУЩИЙ сервер (на котором был игрок)
        blockServer(currentJobId)
        
        -- Телепортируемся
        TeleportService:TeleportToPlaceInstance(placeId, selectedServer)
    else
        warn("Нет доступных серверов для телепортации")
    end
end

-- Запуск (например, по команде или автоматически)
findNewServer()

task.wait(4)

end
end)
