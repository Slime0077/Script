	AddFunction("Main", "KillAllPlayers", "Kill All Players", 2, function()

		for _, Player in pairs(game.Players:GetPlayers()) do
			if Player == game.Players.LocalPlayer then
				continue
			else
				local args = {
					[1] = Player.Character.Humanoid,
					[2] = Player.Character.Humanoid.MaxHealth or 1000
				}

				for _, v in pairs(workspace.Trarp:GetDescendants()) do
					if v.Name == "DamagePlayerRE" then
						v:FireServer(unpack(args))
					end
				end
			end
		end

	end, Color3.new(1, 0, 0), nil, true)
	
