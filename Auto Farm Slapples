-- Автофарм Orbs (без GUI)
task.spawn(function()
    while task.wait() do
        local character = game.Players.LocalPlayer.Character
        local humanoidRootPart = character and character:FindFirstChild("HumanoidRootPart")
        local entered = character and character:FindFirstChild("entered")
        
        if humanoidRootPart and entered then
            for i, v in pairs(game.Workspace:GetChildren()) do
                -- Проверка на ЛЮБЫЕ орбы
                local isOrb = false
                
                if v.Name == "JetOrb" or 
                   v.Name == "PhaseOrb" or 
                   v.Name == "MATERIALIZEOrb" or 
                   v.Name == "SiphonOrb" or
                   (v.Name:find("Orb") and v:FindFirstChild("Attachment") and v.Attachment:FindFirstChild("OrbGlitchEffect")) then
                    isOrb = true
                end
                
                if isOrb then
                    local CFOld = humanoidRootPart.CFrame
                    humanoidRootPart.CFrame = v.CFrame
                    task.wait(0.37)
                    humanoidRootPart.CFrame = CFOld
                    task.wait(0.7)
                end
            end
        end
        task.wait()
    end
end)

task.spawn(function()
    while true do
        repeat task.wait() until game.Players.LocalPlayer.Character
        
        local char = game.Players.LocalPlayer.Character
        if not char:FindFirstChild("entered") and char:FindFirstChild("HumanoidRootPart") then
            repeat task.wait()
                firetouchinterest(char:WaitForChild("Head"), workspace.Lobby.Teleport1.TouchInterest.Parent, 0)
                firetouchinterest(char:WaitForChild("Head"), workspace.Lobby.Teleport1.TouchInterest.Parent, 1)
            until char:FindFirstChild("entered")
        end
        
        task.wait()
    end
end)

task.wait(2.5)

task.spawn(function()
while true do

    local HttpService = game:GetService("HttpService")
    local TeleportService = game:GetService("TeleportService")
    local placeId = game.PlaceId
    local currentJobId = game.JobId
    
    local success, response = pcall(function()
        return game:HttpGetAsync("https://games.roblox.com/v1/games/" .. placeId .. "/servers/Public?sortOrder=Asc&limit=100")
    end)
    
    if not success then
        warn("Server Hop: Не удалось получить список серверов")
        return
    end
    
    local data = HttpService:JSONDecode(response)
    local serverList = {}
    
    for _, server in ipairs(data.data) do
        if server.playing and server.maxPlayers > server.playing and server.id ~= currentJobId then
            table.insert(serverList, server.id)
        end
    end
    
    if #serverList > 0 then
        local randomServer = serverList[math.random(1, #serverList)]
        TeleportService:TeleportToPlaceInstance(placeId, randomServer)
    else
        warn("Server Hop: Не найдено подходящих серверов")
    end

task.wait(4)

end
end)
